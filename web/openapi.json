  "components": {
    "schemas": {
      "AdminUser": {
        "type": "object",
        "description": "One user in the admin list.",
        "required": [
          "id",
          "isAdmin"
        ],
        "properties": {
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "deactivatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "NULL when active; the deactivation timestamp otherwise."
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "lastSeen": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ApiKeyResponse": {
        "type": "object",
        "description": "A stored key, sans any secret material.",
        "required": [
          "id",
          "name",
          "scopes",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "lastUsed": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          }
        }
      },
      "ConnectionResponse": {
        "type": "object",
        "description": "A client holding a live grant on the current user's account.",
        "required": [
          "clientId",
          "scopes",
          "connectedAt",
          "expiresAt"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name from dynamic registration, if the client provided one."
          },
          "connectedAt": {
            "type": "string",
            "description": "When this client was first authorized (ISO 8601, earliest live grant)."
          },
          "expiresAt": {
            "type": "string",
            "description": "Latest access-token expiry across this client's live grants (ISO 8601)."
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          }
        }
      },
      "CreateKeyRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 expiry; never expires when omitted."
          },
          "name": {
            "type": "string",
            "example": "laptop-cli"
          },
          "scopes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Granular `resource:action` scopes (e.g. `example:write`). The aliases\n`read`/`write`/`admin` are also accepted and expanded. Defaults to\nread-only (`example:read`)."
          }
        }
      },
      "CreatedKeyResponse": {
        "type": "object",
        "description": "POST response: the only place the plaintext key ever appears.",
        "required": [
          "id",
          "name",
          "scopes",
          "key"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "description": "The full API key. Store it now; it cannot be retrieved again.",
            "example": "shisho_..."
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          }
        }
      },
      "EditProfileRequest": {
        "type": "object",
        "description": "A direct edit: the full replacement content, optionally pinned to the version\nit was drafted against (a stale base is rejected).",
        "required": [
          "content"
        ],
        "properties": {
          "baseVersion": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The version this edit was drafted against; a mismatch is a 409."
          },
          "changeSummary": {
            "type": [
              "string",
              "null"
            ],
            "description": "One-line summary of what changed; defaults to a generic web-edit note."
          },
          "content": {
            "type": "string",
            "description": "The full new profile content (Markdown)."
          }
        }
      },
      "EncryptionStatus": {
        "type": "object",
        "description": "Read-only encryption status. Never includes key material: key management is\na deployment-layer concern (config + the `shisho encryption` CLI).",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether at-rest encryption is configured."
          },
          "kekVersion": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The active KEK version wrapping the data key, if a keyfile exists.",
            "minimum": 0
          },
          "lastRotatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the data key was last (re)wrapped (first init or KEK rotation)."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Wire format of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code (clients switch on this).",
            "example": "not_found"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "InfoResponse": {
        "type": "object",
        "description": "Instance metadata. Field names are part of the public API contract\n(`auth_mode` is snake_case by convention).",
        "required": [
          "name",
          "version",
          "auth_mode"
        ],
        "properties": {
          "auth_mode": {
            "type": "string",
            "example": "single_user"
          },
          "name": {
            "type": "string",
            "description": "Configured display name of this instance.",
            "example": "Shisho"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        }
      },
      "PendingProposalDto": {
        "type": "object",
        "description": "A stored pending proposal (a `consolidate` output awaiting review).",
        "required": [
          "version",
          "baseVersion",
          "content",
          "changeSummary",
          "diff"
        ],
        "properties": {
          "baseVersion": {
            "type": "integer",
            "format": "int64",
            "description": "The version it was drafted against."
          },
          "changeSummary": {
            "type": "string",
            "description": "One-line summary of what changed and why."
          },
          "content": {
            "type": "string",
            "description": "Proposed Markdown content."
          },
          "diff": {
            "type": "string",
            "description": "Unified diff from the current profile to the proposal."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The version this proposal will become if approved."
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "description": "The current taste profile plus any pending proposal awaiting review.",
        "required": [
          "content",
          "version"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "The current profile content (Markdown). Empty for a version-0 profile."
          },
          "pendingProposal": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PendingProposalDto",
                "description": "A consolidation proposal awaiting the user's approval, if one is pending."
              }
            ]
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the current version was applied (ISO 8601), absent at version 0."
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Scope": {
        "type": "string",
        "description": "API key permission as `resource:action`.",
        "enum": [
          "example:read",
          "example:write",
          "example:delete",
          "keys:manage",
          "candidates:read",
          "lookup:read",
          "library:read",
          "verdicts:write",
          "profile:read",
          "profile:write",
          "status:read"
        ]
      },
      "SetupKeyResponse": {
        "type": "object",
        "description": "The revealed admin key. Returned exactly once.",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Plaintext admin API key. Store it now; it is never shown again."
          }
        }
      },
      "SetupStateResponse": {
        "type": "object",
        "description": "Unconfigured-state report for the wizard.",
        "required": [
          "authMode",
          "providersConfigured"
        ],
        "properties": {
          "authMode": {
            "type": "string",
            "description": "Configured auth mode (`single_user` / `multi_user`)."
          },
          "providersConfigured": {
            "type": "integer",
            "description": "Number of `[[auth.providers]]` already present in config.",
            "minimum": 0
          }
        }
      },
      "VersionDto": {
        "type": "object",
        "description": "One entry in the version history, with its rendered diff.",
        "required": [
          "version",
          "baseVersion",
          "status",
          "changeSummary",
          "createdAt",
          "diff"
        ],
        "properties": {
          "baseVersion": {
            "type": "integer",
            "format": "int64"
          },
          "changeSummary": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "diff": {
            "type": "string",
            "description": "Unified diff from the base version's content to this version's."
          },
          "status": {
            "type": "string",
            "description": "`pending` | `applied` | `rejected` | `superseded`."
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "WhoAmI": {
        "type": "object",
        "description": "The caller's verified identity. `keyId`/`userId` are null when the static\nconfig key authenticated (it lives outside the database).",
        "required": [
          "scopes"
        ],
        "properties": {
          "keyId": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          },
          "userId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "shisho",
      "description": "Core endpoints: health, instance info, and the authenticated-identity echo."
    },
    {
      "name": "keys",
      "description": "API key management. Requires the keys:manage scope. Scopes are granular resource:action strings; the aliases read/write/admin are accepted on creation and expanded."
    },
    {
      "name": "connections",
      "description": "Connected-application (OAuth grant) management. Lists the OAuth clients holding a live grant on the caller's account and revokes one. Requires the keys:manage scope, so a browser session qualifies but a connector's own token does not."
    },
    {
      "name": "profile",
      "description": "Taste-profile management: read the current profile and version history, edit it directly, and approve or reject pending consolidation proposals. Reads require profile:read, writes profile:write."
    },
    {
      "name": "admin",
      "description": "Admin-only operations. In single-user mode the sole operator is the admin; in multi-user mode admin is the admin_emails/admin_groups allowlists, or the first provisioned user when both are empty."
    },
    {
      "name": "setup",
      "description": "First-run setup wizard. Token-gated and available only on an unconfigured instance; every route 404s once a credential is configured."
    }
  ]
}