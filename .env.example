# shisho environment overrides (example).
#
# Copy to .env and edit. docker compose loads it automatically into the
# shisho and shisho-dev services (the file is optional; compose runs
# fine without it). For local non-docker runs, export the variables yourself
# or use a tool like mise/direnv; the binary does not read .env files.
#
# Any config value can be overridden using the SHISHO_ prefix with
# __ as the nesting separator. These take precedence over the config files,
# including the .local overlay.

# [server]
#SHISHO_SERVER__HOST=0.0.0.0
#SHISHO_SERVER__PORT=8080

# [database]
#SHISHO_DATABASE__URL=sqlite://data/shisho.db?mode=rwc
#SHISHO_DATABASE__MAX_CONNECTIONS=16

# [logging]
#SHISHO_LOGGING__LEVEL=info
#SHISHO_LOGGING__JSON=false

# [api]
#SHISHO_API__DOCS=true

# Rust runtime knobs (read by the toolchain, not the config loader)
#RUST_LOG=info
#RUST_BACKTRACE=1
